<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>馬祖行程 2026/10/16–19</name>
  <description>5人家族行程，南竿4天。座標校正版 2026-05-24</description>

  <!-- 顏色樣式（KML 顏色格式：AABBGGRR） -->
  <Style id="day1">
    <IconStyle><color>ff0000ff</color><scale>1.2</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><color>ff0000ff</color></LabelStyle>
    <LineStyle><color>cc0000ff</color><width>4</width></LineStyle>
  </Style>
  <Style id="day2">
    <IconStyle><color>ff0055ff</color><scale>1.2</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/orange-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><color>ff0055ff</color></LabelStyle>
    <LineStyle><color>cc00a5ff</color><width>4</width></LineStyle>
  </Style>
  <Style id="day3">
    <IconStyle><color>ff00aa00</color><scale>1.2</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><color>ff00aa00</color></LabelStyle>
    <LineStyle><color>cc008000</color><width>4</width></LineStyle>
  </Style>
  <Style id="day4">
    <IconStyle><color>ffaa00ff</color><scale>1.2</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/purple-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><color>ffaa00ff</color></LabelStyle>
    <LineStyle><color>cc800080</color><width>4</width></LineStyle>
  </Style>
  <Style id="hotel">
    <IconStyle><color>ff0055ff</color><scale>1.3</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/shapes/lodging.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="airport">
    <IconStyle><scale>1.3</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/shapes/airports.png</href></Icon>
    </IconStyle>
  </Style>

  <!-- 住宿 & 機場 -->
  <Folder>
    <name>🏨 住宿 &amp; 機場</name>
    <Placemark>
      <name>✈️ 南竿機場</name>
      <styleUrl>#airport</styleUrl>
      <description>起降點｜去程12:10/12:55抵｜回程13:40飛高雄</description>
      <Point><coordinates>119.9558,26.1601,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 天后會館（夜1–2）</name>
      <styleUrl>#hotel</styleUrl>
      <description>馬港天后宮旁｜Day1 check-in｜Day3早上退房</description>
      <Point><coordinates>119.9183,26.1598,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 沐光民宿（夜3）</name>
      <styleUrl>#hotel</styleUrl>
      <description>連江縣南竿鄉津沙村137號｜Day3下午入住</description>
      <Point><coordinates>119.9132,26.1461,0</coordinates></Point>
    </Placemark>
  </Folder>

  <!-- Day 1 -->
  <Folder>
    <name>🔴 Day 1｜10/16 南竿戰地巡禮</name>
    <Placemark>
      <name>①  枕戈待旦</name>
      <styleUrl>#day1</styleUrl>
      <description>13:15｜10分｜路邊停車拍照，爸爸朝聖必來，蔣公親題大字</description>
      <Point><coordinates>119.9401,26.1559,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>②  天后會館 check-in / 午餐</name>
      <styleUrl>#day1</styleUrl>
      <description>13:35｜80分｜Check-in + 馬祖米糕、魚丸湯</description>
      <Point><coordinates>119.9183,26.1598,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>③  勝利堡</name>
      <styleUrl>#day1</styleUrl>
      <description>15:00｜45分｜免費戰地博物館，前戰地政務委員會指揮中心</description>
      <Point><coordinates>119.9346,26.1590,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>④  大漢據點</name>
      <styleUrl>#day1</styleUrl>
      <description>16:00｜45分｜免費，長輩逛第一層觀海平台即可，俯瞰南竿全景</description>
      <Point><coordinates>119.9291,26.1406,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>⑤  鐵堡（日落）</name>
      <styleUrl>#day1</styleUrl>
      <description>17:10｜80分｜🌅 10月日落17:30–17:40，穿防滑鞋，17:10前務必抵達</description>
      <Point><coordinates>119.9209,26.1420,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>⑥  介壽村晚餐</name>
      <styleUrl>#day1</styleUrl>
      <description>19:00｜介壽村老街，夜遊廟宇燈火，宵夜小攤</description>
      <Point><coordinates>119.9510,26.1570,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Day 1 路線</name>
      <styleUrl>#day1</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          119.9558,26.1601,0
          119.9401,26.1559,0
          119.9183,26.1598,0
          119.9346,26.1590,0
          119.9291,26.1406,0
          119.9209,26.1420,0
          119.9510,26.1570,0
        </coordinates>
      </LineString>
    </Placemark>
  </Folder>

  <!-- Day 2 -->
  <Folder>
    <name>🟠 Day 2｜10/17 南竿尋根</name>
    <Placemark>
      <name>①  北海坑道</name>
      <styleUrl>#day2</styleUrl>
      <description>08:00｜90分｜⚠️查10/17潮汐 0836-25630｜手鑿地下水道，爸爸當年出公差的地方</description>
      <Point><coordinates>119.9290,26.1425,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>②  鐵板（仁愛村）—爸爸帶路</name>
      <styleUrl>#day2</styleUrl>
      <description>09:45｜105分｜民國60年代南竿「西門町」，請爸爸邊走邊說，手機錄下</description>
      <Point><coordinates>119.9263,26.1451,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>③  午餐（鐵板/馬港附近）</name>
      <styleUrl>#day2</styleUrl>
      <description>11:30｜110分｜從容吃，等酒廠13:40開門</description>
      <Point><coordinates>119.9300,26.1450,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>④  梅石文康中心</name>
      <styleUrl>#day2</styleUrl>
      <description>13:30｜75分｜免費，民國50–60年代最大娛樂重地，老兵回憶核心</description>
      <Point><coordinates>119.9349,26.1475,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>⑤  馬祖酒廠</name>
      <styleUrl>#day2</styleUrl>
      <description>15:00｜60分｜⚠️午休11:30–13:40｜高粱酒品嚐，買伴手禮</description>
      <Point><coordinates>119.9518,26.1610,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>⑥  津沙聚落</name>
      <styleUrl>#day2</styleUrl>
      <description>16:15｜90分｜南竿保存最完整閩東漁村，傍晚最美，長輩友善</description>
      <Point><coordinates>119.9132,26.1461,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>⑦  五人最後晚餐</name>
      <styleUrl>#day2</styleUrl>
      <description>19:00｜挑好餐廳，5人唯一完整晚餐</description>
      <Point><coordinates>119.9510,26.1570,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Day 2 路線</name>
      <styleUrl>#day2</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          119.9183,26.1598,0
          119.9290,26.1425,0
          119.9263,26.1451,0
          119.9300,26.1450,0
          119.9349,26.1475,0
          119.9518,26.1610,0
          119.9132,26.1461,0
          119.9510,26.1570,0
        </coordinates>
      </LineString>
    </Placemark>
  </Folder>

  <!-- Day 3 -->
  <Folder>
    <name>🟢 Day 3｜10/18 升天祭 · 送爸媽 · 夫妻日</name>
    <Placemark>
      <name>①  馬港天后宮（媽祖升天祭）</name>
      <styleUrl>#day3</styleUrl>
      <description>08:00–11:00｜全員｜農曆九月初九正日，三重緣分（爸爸服役地/媽祖信仰/全家同拜）</description>
      <Point><coordinates>119.9169,26.1609,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>②  介壽村伴手禮</name>
      <styleUrl>#day3</styleUrl>
      <description>11:00–11:45｜全員｜高粱酒、花生糖、魚麵、繼光餅</description>
      <Point><coordinates>119.9510,26.1570,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>③  南竿機場（送爸媽）</name>
      <styleUrl>#day3</styleUrl>
      <description>爸媽11:45出發｜立榮B7-8732 12:50起飛→台中13:55</description>
      <Point><coordinates>119.9558,26.1601,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>④  津沙聚落（夫妻）</name>
      <styleUrl>#day3</styleUrl>
      <description>14:00–17:00｜夫妻｜石板路、沙灘漫步，日落最美</description>
      <Point><coordinates>119.9132,26.1461,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>⑤  沐光民宿 check-in</name>
      <styleUrl>#day3</styleUrl>
      <description>17:00｜夫妻｜津沙村137號，兩人世界開始</description>
      <Point><coordinates>119.9132,26.1461,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>⑥  藍眼淚（備選）</name>
      <styleUrl>#day3</styleUrl>
      <description>21:00備選｜依天況月相｜芙蓉澳或牛角灣，無月亮清晴夜最佳</description>
      <Point><coordinates>119.9191,26.1677,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Day 3 路線（全員）</name>
      <styleUrl>#day3</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          119.9183,26.1598,0
          119.9169,26.1609,0
          119.9510,26.1570,0
          119.9558,26.1601,0
          119.9132,26.1461,0
        </coordinates>
      </LineString>
    </Placemark>
  </Folder>

  <!-- Day 4 -->
  <Folder>
    <name>🟣 Day 4｜10/19 夫妻自由日 → 飛高雄</name>
    <Placemark>
      <name>①  雲台山</name>
      <styleUrl>#day4</styleUrl>
      <description>08:00｜90分｜南竿制高點，早晨雲霧最美，晴天遠眺北竿及對岸</description>
      <Point><coordinates>119.9283,26.1525,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>②  藍眼淚生態館</name>
      <styleUrl>#day4</styleUrl>
      <description>09:45｜45分｜室內展館，10月戶外已近尾聲，室內版替代</description>
      <Point><coordinates>119.9191,26.1677,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>③  介壽村午餐 + 補伴手禮</name>
      <styleUrl>#day4</styleUrl>
      <description>10:45｜90分｜最後一餐 + 最後採購機會</description>
      <Point><coordinates>119.9510,26.1570,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>④  南竿機場（返高雄）</name>
      <styleUrl>#airport</styleUrl>
      <description>12:30到機場｜華信AE-7926 13:40起飛→高雄15:20｜訂位E7L8A5</description>
      <Point><coordinates>119.9558,26.1601,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Day 4 路線</name>
      <styleUrl>#day4</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          119.9132,26.1461,0
          119.9283,26.1525,0
          119.9191,26.1677,0
          119.9510,26.1570,0
          119.9558,26.1601,0
        </coordinates>
      </LineString>
    </Placemark>
  </Folder>

</Document>
